# PostgreSQL connection string (Railway provides this automatically when you
# attach a Postgres plugin to this service as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/rocket_league_hub"

# Used by NextAuth to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-secret"

# Public URL of the deployed site (Railway sets this to your service domain)
NEXTAUTH_URL="http://localhost:3000"

# Credentials for the very first admin account, created by `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# --- Email reminders (SMTP) ---
# Any SMTP provider works: Gmail app password, SendGrid, Mailgun, Resend SMTP, etc.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey-or-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Rocket League Team <no-reply@example.com>"

# How many hours before an event to send the reminder email (default 3)
REMINDER_LEAD_HOURS="3"

# Set to "true" to disable the built-in cron scheduler (e.g. if you trigger
# reminders externally instead)
DISABLE_REMINDER_CRON="false"

# --- Ballchasing.com replay import (optional) ---
# Lets admins paste a ballchasing.com replay link on an event to auto-fill
# Performance stats for matched players. Get a free key by logging in with
# Steam at https://ballchasing.com/upload and copying your API token from
# https://ballchasing.com/doc/api (top of the page once logged in).
BALLCHASING_API_KEY=""
