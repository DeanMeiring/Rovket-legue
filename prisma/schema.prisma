generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  TRYOUT
  SCRIM
  MATCH
  TOURNAMENT
  PRACTICE
  MEETING
  OTHER
}

enum RsvpStatus {
  PENDING
  GOING
  MAYBE
  DECLINED
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  email         String     @unique
  passwordHash  String
  role          Role       @default(PLAYER)
  // Off for staff-only admins: they manage the site but aren't on the roster,
  // in availability, RSVP lists or team balancing.
  isPlayer      Boolean    @default(true)
  // The main admin (the ADMIN_USERNAME account, set on every deploy) decides
  // which admins get sign-up emails and who else is a main admin.
  isMainAdmin   Boolean    @default(false)
  notifySignups Boolean    @default(true)
  status        UserStatus @default(PENDING)

  displayName      String?
  rlTrackerUrl     String?
  platform         String?
  discordTag       String?
  // Set when the player links their Discord account through the bot's /link command.
  discordId        String? @unique
  discordUsername  String?
  bio              String?
  rank1v1          Int?
  rank2v2          Int?
  rank3v3          Int?
  profileCompleted Boolean @default(false)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdEvents Event[]             @relation("EventCreatedBy")
  rsvps         EventRsvp[]
  performances  Performance[]
  tryoutEntry   TryoutPlayer?
  aliases       PlayerAlias[]
  reviews       PlayerReview[]
  availability  PlayerAvailability?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
}

model Team {
  id                    String   @id @default(cuid())
  name                  String   @unique
  colorHex              String?
  // The team's Discord role and its private category with text and voice channels, made by the bot.
  discordRoleId         String?
  discordCategoryId     String?
  discordTextChannelId  String?
  discordVoiceChannelId String?
  members               User[]
  events                Event[]  @relation("EventAudience")
  createdAt             DateTime @default(now())
}

model Event {
  id          String    @id @default(cuid())
  title       String
  type        EventType @default(SCRIM)
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  reminderSentAt        DateTime?
  // The Discord ping about an hour before the start.
  discordReminderSentAt DateTime?

  // Players can only RSVP while this is on. Tournaments start closed until
  // the teams are confirmed.
  rsvpOpen Boolean @default(true)

  // Who the event is for. Everyone, or only players in audienceTeams; only
  // they see it, get its emails and get an RSVP.
  forEveryone   Boolean @default(true)
  audienceTeams Team[]  @relation("EventAudience")

  rsvps           EventRsvp[]
  performances    Performance[]
  pendingStats    PendingPerformance[]
  replays         EventReplay[]
  discordMessages EventDiscordMessage[]

  // Game roster for the session: who is playing (user ids), how many games,
  // 3v3 or 2v2, and whether players can see it yet.
  rosterPool     String[] @default([])
  rosterGames    Int      @default(6)
  rosterTeamSize Int      @default(3)
  rosterShared   Boolean  @default(false)
  games          EventGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
}

// The bot's announcement of an event in a Discord channel, kept so it can be
// edited (RSVP counts, changes) or removed with the event.
model EventDiscordMessage {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channelId String
  messageId String

  @@unique([channelId, messageId])
  @@index([eventId])
}

model EventRsvp {
  id      String     @id @default(cuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  RsvpStatus @default(PENDING)

  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model Performance {
  id      String  @id @default(cuid())
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  goals   Int      @default(0)
  assists Int      @default(0)
  saves   Int      @default(0)
  shots   Int      @default(0)
  score   Int      @default(0)
  mvp     Boolean  @default(false)
  win     Boolean?
  notes   String?
  // ballchasing replay the row was imported from, so importing a group twice
  // doesn't count the same game twice.
  replayId String?

  createdAt DateTime @default(now())

  @@unique([replayId, userId])
  @@index([userId])
  @@index([eventId])
}

// Admin-maintained tryout roster. Separate from User so admins can add
// players who haven't made an account yet; `userId` links the two once they do.
model TryoutPlayer {
  id          String  @id @default(cuid())
  tag         String
  name        String?
  // 0 = new / unassigned, 1-4 = current team
  currentTeam Int     @default(0)
  rank2v2     Int?
  rank3v3     Int?
  notes       String?
  trackerUrl  String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Private one-time link (/claim/<token>) the admin sends so this player can
  // set up their own account. Cleared once it is used.
  claimToken String? @unique

  gameStats TryoutGameStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One generated 3v3 tryout game. Sides hold TryoutPlayer ids, balanced on
// rating when generated. Stats arrive later from a ballchasing.com replay.
model TryoutGame {
  id          String   @id @default(cuid())
  number      Int      @unique
  round       Int
  blueIds     String[]
  orangeIds   String[]
  blueGoals   Int?
  orangeGoals Int?

  ballchasingId String?
  // "pending" while ballchasing is still processing the upload, then "ok"
  replayStatus  String?

  stats TryoutGameStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TryoutGameStat {
  id       String       @id @default(cuid())
  gameId   String
  game     TryoutGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId String
  player   TryoutPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  side    String // "blue" | "orange"
  win     Boolean
  goals   Int     @default(0)
  assists Int     @default(0)
  saves   Int     @default(0)
  shots   Int     @default(0)
  score   Int     @default(0)
  mvp     Boolean @default(false)

  boostPerMinute    Float?
  avgSpeed          Float?
  percentBehindBall Float?
  demosInflicted    Int?
  // Full ballchasing stats block for this player, used by the AI evaluation.
  raw               Json?

  @@unique([gameId, playerId])
  @@index([playerId])
}

// Saved AI write-ups of the tryout stats, newest shown first.
model TryoutEvaluation {
  id        String   @id @default(cuid())
  text      String
  model     String
  createdAt DateTime @default(now())
}

// A player's usual weekly availability, as "<day>-<block>" keys such as
// "mon-evening" (see src/lib/availability.ts).
model PlayerAvailability {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots     String[]
  note      String?
  updatedAt DateTime @updatedAt
}

// One game in an event's roster. Played games stay as they are when the
// roster is rebalanced; the rest are rebuilt from the current pool.
model EventGame {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  number      Int
  round       Int
  blueIds     String[]
  orangeIds   String[]
  played      Boolean  @default(false)
  blueGoals   Int?
  orangeGoals Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, number])
}

// Replay stats for an in-game name that didn't match any account, waiting for
// an admin to say who it is.
model PendingPerformance {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  replayId   String
  playerName String
  goals      Int     @default(0)
  assists    Int     @default(0)
  saves      Int     @default(0)
  shots      Int     @default(0)
  score      Int     @default(0)
  mvp        Boolean @default(false)
  win        Boolean?

  createdAt DateTime @default(now())

  @@unique([eventId, replayId, playerName])
}

// An in-game name an admin matched to an account, used by later imports.
model PlayerAlias {
  id     String @id @default(cuid())
  name   String @unique // lowercased
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Ballchasing replays already imported into an event.
model EventReplay {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  replayId String

  createdAt DateTime @default(now())

  @@unique([eventId, replayId])
}

// AI-written review of one player. Players only see it once published.
model PlayerReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  model     String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Research on how pro Rocket League players play and how coaches assess them,
// written once and reused by every player review.
model CoachingBrief {
  id        String   @id @default(cuid())
  text      String
  model     String
  createdAt DateTime @default(now())
}
