generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  TRYOUT
  SCRIM
  MATCH
  TOURNAMENT
  PRACTICE
  MEETING
  OTHER
}

enum RsvpStatus {
  PENDING
  GOING
  MAYBE
  DECLINED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         Role       @default(PLAYER)
  status       UserStatus @default(PENDING)

  displayName      String?
  rlTrackerUrl     String?
  platform         String?
  discordTag       String?
  bio              String?
  rank1v1          Int?
  rank2v2          Int?
  rank3v3          Int?
  profileCompleted Boolean @default(false)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdEvents Event[]             @relation("EventCreatedBy")
  rsvps         EventRsvp[]
  performances  Performance[]
  tryoutEntry   TryoutPlayer?
  availability  PlayerAvailability?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  colorHex  String?
  members   User[]
  createdAt DateTime @default(now())
}

model Event {
  id          String    @id @default(cuid())
  title       String
  type        EventType @default(SCRIM)
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  reminderSentAt DateTime?

  // Players can only RSVP while this is on. Tournaments start closed until
  // the teams are confirmed.
  rsvpOpen Boolean @default(true)

  rsvps        EventRsvp[]
  performances Performance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
}

model EventRsvp {
  id      String     @id @default(cuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  RsvpStatus @default(PENDING)

  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model Performance {
  id      String  @id @default(cuid())
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  goals   Int      @default(0)
  assists Int      @default(0)
  saves   Int      @default(0)
  shots   Int      @default(0)
  score   Int      @default(0)
  mvp     Boolean  @default(false)
  win     Boolean?
  notes   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventId])
}

// Admin-maintained tryout roster. Separate from User so admins can add
// players who haven't made an account yet; `userId` links the two once they do.
model TryoutPlayer {
  id          String  @id @default(cuid())
  tag         String
  name        String?
  // 0 = new / unassigned, 1-4 = current team
  currentTeam Int     @default(0)
  rank2v2     Int?
  rank3v3     Int?
  notes       String?
  trackerUrl  String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Private one-time link (/claim/<token>) the admin sends so this player can
  // set up their own account. Cleared once it is used.
  claimToken String? @unique

  gameStats TryoutGameStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One generated 3v3 tryout game. Sides hold TryoutPlayer ids, balanced on
// rating when generated. Stats arrive later from a ballchasing.com replay.
model TryoutGame {
  id          String   @id @default(cuid())
  number      Int      @unique
  round       Int
  blueIds     String[]
  orangeIds   String[]
  blueGoals   Int?
  orangeGoals Int?

  ballchasingId String?
  // "pending" while ballchasing is still processing the upload, then "ok"
  replayStatus  String?

  stats TryoutGameStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TryoutGameStat {
  id       String       @id @default(cuid())
  gameId   String
  game     TryoutGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId String
  player   TryoutPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  side    String // "blue" | "orange"
  win     Boolean
  goals   Int     @default(0)
  assists Int     @default(0)
  saves   Int     @default(0)
  shots   Int     @default(0)
  score   Int     @default(0)
  mvp     Boolean @default(false)

  boostPerMinute    Float?
  avgSpeed          Float?
  percentBehindBall Float?
  demosInflicted    Int?
  // Full ballchasing stats block for this player, used by the AI evaluation.
  raw               Json?

  @@unique([gameId, playerId])
  @@index([playerId])
}

// Saved AI write-ups of the tryout stats, newest shown first.
model TryoutEvaluation {
  id        String   @id @default(cuid())
  text      String
  model     String
  createdAt DateTime @default(now())
}

// A player's usual weekly availability, as "<day>-<block>" keys such as
// "mon-evening" (see src/lib/availability.ts).
model PlayerAvailability {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots     String[]
  note      String?
  updatedAt DateTime @updatedAt
}
