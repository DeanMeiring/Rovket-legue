{
  "name": "rocket-league-team-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:release": "prisma migrate deploy && tsx prisma/seed.ts && next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env ./node_modules/.bin/tsx prisma/seed.ts",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "prisma": "^5.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
